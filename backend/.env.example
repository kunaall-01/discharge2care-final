# Copy this file to backend/.env for local development.
# On Render, set these in the service's Environment tab instead of committing a .env.

# MongoDB Atlas connection string (SRV format).
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Name of the database the app reads and writes.
DB_NAME=discharge2care

# Comma-separated allowed browser origins. No spaces around the commas.
# A wildcard (*) cannot be combined with allow_credentials=True — browsers reject it.
CORS_ORIGINS=https://discharge2care-final.onrender.com,http://localhost:3000

# Port uvicorn binds to. Render overrides this with its own injected PORT.
PORT=8000

# Optional: chemist salt-equivalence verification. With no key set, the
# endpoint answers from the local drug database instead — it never fails.
# Set exactly one key; LLM_PROVIDER forces a choice when several are present.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=12
